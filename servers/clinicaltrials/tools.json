{
 "tools": [
  {
   "name": "search_trials",
   "description": "Search ClinicalTrials.gov studies.\n\nArgs:\n  query: free-text terms (e.g. \"177Lu PSMA\", \"CAIX girentuximab\").\n  condition: condition filter (e.g. \"prostate cancer\").\n  intervention: intervention/drug filter (e.g. \"Illuccix\").\n  status: comma list of RECRUITING, ACTIVE_NOT_RECRUITING, COMPLETED, NOT_YET_RECRUITING, TERMINATED...\n  phase: PHASE1 | PHASE2 | PHASE3 | PHASE4 | EARLY_PHASE1.\n  country: e.g. \"Australia\".\n  page_size: 1-50.",
   "inputSchema": {
    "properties": {
     "query": {
      "type": "string"
     },
     "condition": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "intervention": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "status": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "phase": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "country": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null
     },
     "page_size": {
      "default": 10,
      "type": "integer"
     }
    },
    "required": [
     "query"
    ],
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": true,
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "get_trial",
   "description": "Get a single study by NCT id (e.g. NCT04689828). Returns summary + eligibility + outcomes.",
   "inputSchema": {
    "properties": {
     "nct_id": {
      "type": "string"
     }
    },
    "required": [
     "nct_id"
    ],
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": true,
    "type": "object"
   },
   "annotations": {
    "readOnlyHint": true,
    "openWorldHint": true
   }
  },
  {
   "name": "trial_locations",
   "description": "List sites (facility, city, country, status) for a study.",
   "inputSchema": {
    "properties": {
     "nct_id": {
      "type": "string"
     }
    },
    "required": [
     "nct_id"
    ],
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": true,
